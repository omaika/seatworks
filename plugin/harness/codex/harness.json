{
  "id": "codex",
  "label": "Codex",
  "baseProvider": "codex",
  "profileRoot": "HOME/.codex/seats",
  "configDirEnv": "CODEX_HOME",
  "contextFile": "AGENTS.md",
  "skillsDir": "skills",
  "sandboxedOn": ["darwin", "linux", "win32"],
  "timeline": {
    "pseudoCalls": [
      {
        "name": "terminal",
        "detail": "plain_text"
      }
    ]
  },
  "mcp": {
    "file": "config.toml",
    "delivery": "launch",
    "preapprove": true,
    "transports": [
      "stdio",
      "http"
    ]
  },
  "settings": {
    "file": "config.toml",
    "source": "settings.toml",
    "roleSource": "settings/ROLE.settings.toml",
    "platforms": {
      "win32": "settings.win32.toml"
    },
    "inherits": {
      "from": "HOME/.codex/config.toml",
      "keys": [
        "model_provider",
        "model_providers"
      ]
    }
  },
  "stateWrites": {
    "path": "sandbox_workspace_write.writable_roots",
    "delivery": "file",
    "profile": {
      "key": "default_permissions",
      "at": "permissions.PROFILE.filesystem",
      "value": "write"
    }
  },
  "files": {
    "rules/seatworks.rules": [
      "rules/seat.rules",
      "rules/ROLE.rules"
    ]
  },
  "modelCatalog": {
    "command": [
      "codex",
      "debug",
      "models",
      "--bundled"
    ],
    "list": "models",
    "clear": [
      "multi_agent_version"
    ],
    "file": "model-catalog.json",
    "setting": "model_catalog_json"
  },
  "links": [
    {
      "link": "auth.json",
      "target": "HOME/.codex/auth.json"
    }
  ],
  "checks": [
    {
      "path": "HOME/.codex/auth.json",
      "help": "Log in with `codex login` once, outside any seat; every Codex seat shares that login."
    }
  ],
  "provider": {
    "env": {
      "SEATWORKS_HARNESS": "codex",
      "SEATWORKS_AGENT_BIN": "codex"
    }
  },
  "refuses": {
    "commands": {
      "file": "rules/seatworks.rules",
      "line": "prefix_rule(pattern = {words}, decision = \"forbidden\", justification = {why})"
    }
  }
}
