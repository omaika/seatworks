{
  "serialOnly": [
    "package-lock.json",
    "pnpm-lock.yaml",
    "yarn.lock",
    "bun.lock",
    "Cargo.lock",
    "go.sum",
    "**/migrations/**",
    "**/db/migrate/**",
    "ProjectSettings/**",
    "Packages/manifest.json",
    "**/*.unity",
    "**/*.prefab",
    "**/*.asset",
    "**/*.uasset",
    "**/*.umap",
    "**/*.pbxproj",
    "**/*.csproj",
    "**/*.sln"
  ],
  "riskRules": [
    {
      "paths": [
        "**/migration/**",
        "**/migrations/**",
        "**/migrate/**",
        "**/schema/**",
        "**/schema.*",
        "**/*.sql"
      ],
      "invariant": "running it a second time changes nothing, and the data from before can be got back",
      "reviewQuestion": "What does running this a second time do to data it already changed, and how is the data from before got back if it goes wrong?"
    }
  ],
  "gates": [
    {
      "files": [
        "package.json"
      ],
      "script": "test",
      "run": "npm test",
      "lockfiles": {
        "pnpm-lock.yaml": "pnpm test",
        "yarn.lock": "yarn test",
        "bun.lock": "bun run test",
        "bun.lockb": "bun run test"
      }
    },
    {
      "files": [
        "mvnw"
      ],
      "platforms": [
        "darwin",
        "linux"
      ],
      "run": "./mvnw -q test"
    },
    {
      "files": [
        "mvnw.cmd"
      ],
      "platforms": [
        "win32"
      ],
      "run": ".\\mvnw.cmd -q test"
    },
    {
      "files": [
        "pom.xml"
      ],
      "run": "mvn -q test"
    },
    {
      "files": [
        "gradlew"
      ],
      "platforms": [
        "darwin",
        "linux"
      ],
      "run": "./gradlew test"
    },
    {
      "files": [
        "gradlew.bat"
      ],
      "platforms": [
        "win32"
      ],
      "run": ".\\gradlew.bat test"
    },
    {
      "files": [
        "Cargo.toml"
      ],
      "run": "cargo test"
    },
    {
      "files": [
        "go.mod"
      ],
      "run": "go test ./..."
    },
    {
      "files": [
        "pyproject.toml",
        "pytest.ini"
      ],
      "run": "pytest -q"
    }
  ],
  "scriptRunners": [
    "npm",
    "pnpm",
    "yarn",
    "bun"
  ],
  "launchers": [
    "npx",
    "bunx"
  ],
  "unsetScript": "no test specified",
  "files": {
    "test": "(^|/)(tests?|__tests__|spec|specs)/|\\.(test|spec)\\.[a-z0-9]+$|(?-i:(Test|Tests|IT)\\.(java|kt|scala|cs))$|(?-i:_test\\.(go|py|rb))$|(?-i:(^|/)test_[^/]+\\.py)$",
    "docs": "\\.(md|mdx|txt|rst|adoc)$|(^|/)docs?/"
  },
  "issues": [
    {
      "match": "^https?://([\\w.-]+)/([\\w.-]+/[\\w.-]+)/issues/(\\d+)",
      "run": [
        "gh",
        "issue",
        "view",
        "$3",
        "-R",
        "$1/$2",
        "--json",
        "title,url,body"
      ]
    },
    {
      "match": "^([\\w.-]+/[\\w.-]+)#(\\d+)$",
      "run": [
        "gh",
        "issue",
        "view",
        "$2",
        "-R",
        "$1",
        "--json",
        "title,url,body"
      ]
    },
    {
      "match": "^#?(\\d+)$",
      "run": [
        "gh",
        "issue",
        "view",
        "$1",
        "--json",
        "title,url,body"
      ]
    }
  ],
  "watch": {
    "skipped": "\\.(skip|only|todo)\\b|\\bx(it|describe|test)\\b|@Disabled\\b|pytest\\.mark\\.skip\\b",
    "assertion": "\\b(assert|expect)\\b|\\.should\\b",
    "refused": "permission|denied|not allowed|refused|blocked by",
    "runners": [
      "npm",
      "pnpm",
      "yarn",
      "bun",
      "npx",
      "bunx",
      "uv",
      "uvx",
      "poetry",
      "pipenv",
      "python",
      "python3",
      "cargo",
      "go",
      "make",
      "just",
      "deno",
      "node",
      "dotnet",
      "mvn",
      "gradle",
      "./gradlew",
      "git",
      "gh",
      "docker",
      "kubectl"
    ],
    "certainty": "\\b(?:report|raise|flag|list|mention|include)\\b[^.]{0,20}\\bonly\\b[^.]{0,40}\\b(?:certain|sure|confident|proven|prove|confirmed|verified)\\b|\\bonly\\b[^.]{0,20}\\b(?:report|raise|flag|list|mention)\\b[^.]{0,40}\\b(?:certain|sure|confident|proven|prove|confirmed|verified)\\b|\\bno\\s+(?:speculation|speculative|guesswork|guesses|hypotheses|maybes)\\b|\\bhigh[- ]confidence\\b[^.]{0,20}\\bonly\\b|\\bonly\\b[^.]{0,20}\\bhigh[- ]confidence\\b|\\b(?:do\\s*n[o']?t|never)\\s+(?:report|raise|flag)\\b[^.]{0,30}\\bunless\\b",
    "prewritten": {
      "code": "```[\\s\\S]*?(?:^|\\n)\\s*(?:import|from|export|const|let|var|def|class|function|fn|public|private|#include|package)\\b",
      "step": "^\\s*(?:step\\s*)?[1-9][.)]\\s*(?:then\\s+)?(?:create|add|write|edit|update|rename|move|delete|remove|implement|refactor|extract|install|register|wire|import|export)\\b",
      "then": "\\b(?:then|next|after that)\\b[^.]{0,30}\\b(?:create|add|write|edit|rename|move|delete|implement)\\b",
      "fileMember": "\\b[\\w-]+(?:\\/[\\w-]+)*\\.[a-z]{1,4}\\b[^.]{0,40}\\b(?:function|method|class|const|export|field|column|endpoint)\\b"
    }
  },
  "turnFailures": [
    {
      "kind": "a usage limit",
      "match": "usage limit|limit reached|quota exceeded|credit balance is too low|out of credits",
      "passes": "when the agent's limit resets, as its error may say"
    },
    {
      "kind": "a rate limit",
      "match": "rate.?limit|\\b429\\b|too many requests",
      "passes": "in a minute or two"
    },
    {
      "kind": "the model being overloaded",
      "match": "overloaded|\\b529\\b|\\b503\\b|service unavailable|over capacity",
      "passes": "in a few minutes"
    },
    {
      "kind": "a login that failed",
      "match": "\\b401\\b|unauthori[sz]ed|authentication (failed|error)|invalid api key|not logged in|log in again"
    },
    {
      "kind": "a context that ran out",
      "match": "context (window|length)|prompt is too long|maximum context|context_length_exceeded"
    }
  ]
}
